; Salt Line — Godot 4 project.
;
; The project root is the repository root so that `res://art/...` is the same
; path the sprite generator writes to. There is no asset copy step.
;
; Every setting under [display] and [rendering] here is load-bearing for
; DESIGN §5.1. Changing one of them breaks the low-resolution presentation:
;
;   stretch/mode = "viewport"   render at the internal size, scale the result
;   stretch/aspect = "expand"   let the width float, keep the height fixed
;   default_texture_filter = 0  nearest, project-wide — one missed material is
;                               the whole illusion
;
; The internal buffer is 320x180 here and re-sized at runtime to
; `clamp(round(180 * device_aspect), 320, 400) x 180` (216 tall under Long
; Lens), which is what "fix the height, let the width float" means in practice.

config_version=5

[application]

config/name="Salt Line"
config/version="0.1.0-preview"
config/description="Single-player artillery roguelike. Endless procedural horizon, persistent terrain damage."
run/main_scene="res://godot/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[rendering]

textures/canvas_textures/default_texture_filter=0
; Required to export for arm64 or universal macOS, which refuses to build
; without an ETC2/ASTC path available. Every texture here is imported
; lossless (compress/mode=0), so nothing actually gets VRAM-compressed and
; the nearest-neighbour presentation is unaffected.
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_2d=0
anti_aliasing/quality/screen_space_aa=0
textures/default_filters/use_nearest_mipmap_filter=true
textures/default_filters/anisotropic_filtering_level=0
environment/defaults/default_clear_color=Color(0.141, 0.212, 0.361, 1)
; The game draws every frame into one texture itself, so on phones the
; Compatibility renderer (OpenGL ES) is all it needs, and it runs on devices
; and emulators where Vulkan presentation fails. Desktop keeps Forward+.
renderer/rendering_method.mobile="gl_compatibility"
