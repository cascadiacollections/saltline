; Counterweight: Game Off 2026. Godot 4 project.
;
; Settings carried over from Salt Line, where each one was measured:
;   rendering_method = "gl_compatibility"  one software-rastered texture needs
;       nothing from Forward+; Compatibility cost ~190 MiB less on desktop
;       (Salt Line docs/rendering-footprint.md) and is the Web renderer anyway
;   default_texture_filter = 0  nearest, project-wide
;   stretch canvas_items / keep / integer  the 320x180 frame scales by whole
;       steps, letterboxed, so every game pixel is the same size (nearest
;       filtering at 3.4x leaves uneven columns)
;   boot splash  black, no image: the game's first frame is the title
;   msaa / screen-space AA off   nothing to smooth in a pixel frame
; Everything the game shows or plays is embedded in the GDExtension, so this
; project has no assets to import.

config_version=5

[application]

config/name="Counterweight"
config/description="One coast, two eras. Break the line in both. GitHub Game Off 2026."
run/main_scene="res://main.tscn"
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"
window/vsync/vsync_mode=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_2d=0
anti_aliasing/quality/screen_space_aa=0
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
